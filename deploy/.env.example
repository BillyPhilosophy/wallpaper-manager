# Docker Hub 镜像命名空间；本地源码构建可保留 local
DOCKERHUB_USERNAME=local
IMAGE_TAG=latest

# 所有应用数据的宿主机根目录，可改为外接硬盘路径
WALLPAPER_DATA_ROOT=/srv/wallpaper-manager

# Steam Web API Key，与 SteamCMD 登录配置相互独立
STEAM_WEB_API_KEY=

MAX_QUEUE_LENGTH=20

# 可选：Steam 搜索、订阅同步和 SteamCMD 使用的 HTTP 代理，留空表示直连
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
NO_PROXY=localhost,127.0.0.1,web,api,worker,redis
