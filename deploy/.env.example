# Docker Hub 镜像命名空间；本地源码构建可保留 local
DOCKERHUB_USERNAME=local
IMAGE_TAG=latest

# 应用数据根目录：SQLite 数据库、staging、steam-config、trash 等小文件高频读写。
# 建议放树莓派本地盘（SD/eMMC），不要放移动硬盘——高频 fsync 易让移动盘 ext4 报 I/O error。
WALLPAPER_DATA_ROOT=/srv/wallpaper-manager

# 壁纸文件目录：大文件、读多写少，可单独挂到移动硬盘。
# 不设置时默认 ${WALLPAPER_DATA_ROOT}/steam-data，与旧部署兼容。
# STEAM_DATA_ROOT=/mnt/data/data/steam-data

# Steam Web API Key，与 DepotDownloader 登录配置相互独立
STEAM_WEB_API_KEY=

# 可选：加密 maFiles 的 passkey 文件，使用受保护数据卷中的容器内路径
# STEAMGUARD_CLI_PASSKEY_FILE=/steam-config/steamguard/passkey

MAX_QUEUE_LENGTH=20

# 可选：direct=只直连，proxy=只走代理，auto=直连失败后切代理；默认配置代理时走 proxy，未配置时走 direct
# STEAM_NETWORK_MODE=auto
# STEAM_PROXY_URL=http://host.docker.internal:7890
# 也可用 HTTP_PROXY/HTTPS_PROXY 指定代理，STEAM_PROXY_URL 优先
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
NO_PROXY=localhost,127.0.0.1,web,api,worker,redis
