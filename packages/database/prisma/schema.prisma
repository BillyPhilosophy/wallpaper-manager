generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Wallpaper {
  workshopId        String        @id
  title             String
  description       String?
  type              String        @default("unknown")
  contentRating     String        @default("unrated")
  subscribed        Boolean       @default(false)
  officialPreviewUrl String?
  metadataJson      String        @default("{}")
  localRelativePath String?
  status            String        @default("not_downloaded")
  fileSizeBytes     BigInt?
  lastErrorCode     String?
  lastErrorMessage  String?
  downloadedAt      DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  jobs              DownloadJob[]
  groupItems        WallpaperGroupItem[]

  @@index([status, type])
}

model WallpaperGroup {
  id             String               @id @default(uuid())
  name           String
  normalizedName String               @unique
  color          String               @default("#4f8cff")
  sortOrder      Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  items          WallpaperGroupItem[]
}

model WallpaperGroupItem {
  groupId    String
  workshopId String
  sortOrder  Int            @default(0)
  createdAt  DateTime       @default(now())
  group      WallpaperGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  wallpaper  Wallpaper      @relation(fields: [workshopId], references: [workshopId], onDelete: Cascade)

  @@id([groupId, workshopId])
  @@index([workshopId])
  @@index([groupId, sortOrder])
}

model DownloadJob {
  id           String    @id
  workshopId   String
  activeWorkshopId String? @unique
  wallpaper    Wallpaper @relation(fields: [workshopId], references: [workshopId], onDelete: Cascade)
  status       String    @default("queued")
  attempt      Int       @default(1)
  errorCode    String?
  errorMessage String?
  createdAt    DateTime  @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?

  @@index([workshopId, status])
  @@index([status, createdAt])
}

model SteamAuthState {
  id          Int      @id @default(1)
  status      String   @default("auth_required")
  message     String?
  accountName String?
  steamId     String?
  updatedAt   DateTime @updatedAt
}

model Favorite {
  workshopId         String   @id
  title              String
  officialPreviewUrl String?
  type               String   @default("unknown")
  contentRating      String   @default("unrated")
  createdAt          DateTime @default(now())

  @@index([createdAt])
}
